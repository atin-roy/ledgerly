meta {
  name: Login
  type: https
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "atinroy1357@gmail.com",
    "password": "testPassword123"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("auth_token", res.body.token);
  }
}
