meta {
  name: Create Transaction
  type: https
  seq: 1
}

post {
  url: {{base_url}}/transactions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "amount": 50.00,
    "description": "Groceries",
    "categoryId": 1,
    "transactionDate": "2025-01-27"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.amount: eq 50.00
}