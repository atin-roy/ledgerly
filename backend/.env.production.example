# Ledgerly Backend - Production Environment Variables Template
# Copy to /srv/apps/ledgerly/.env on the VPS (see DEPLOYMENT.md). Never commit the real file.

# ============================================================
# DATABASE
# ============================================================
# Standard JDBC URL against the ledgerly-postgres container (see docker-compose.prod.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://ledgerly-postgres:5432/ledgerly
SPRING_DATASOURCE_USERNAME=ledgerly
SPRING_DATASOURCE_PASSWORD=  # openssl rand -base64 32

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# Generate a strong secret with: openssl rand -base64 64
# Must be at least 32 characters (256 bits) - REQUIRED, application fails to start if unset
JWT_SECRET=<GENERATE-STRONG-SECRET-HERE>

# ============================================================
# CORS & SECURITY
# ============================================================
# Same-origin in production (Caddy routes /api to this service), so this is
# only exercised by non-browser clients. Never use a wildcard.
CORS_ALLOWED_ORIGINS=https://ledgerly.atinroy.com

# ============================================================
# APPLICATION & SERVER
# ============================================================
SPRING_PROFILES_ACTIVE=prod
