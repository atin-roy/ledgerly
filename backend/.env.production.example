# Ledgerly Backend - Production Environment Variables Template
# Copy this to Railway dashboard and fill in the values

# ============================================================
# DATABASE
# ============================================================
# Automatically provided by Railway when adding PostgreSQL service
# Format: postgres://username:password@host:port/database
# DO NOT set manually - Railway will provide DATABASE_URL
# DATABASE_URL=<AUTO-PROVIDED-BY-RAILWAY>

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# Generate a strong secret with: openssl rand -base64 32
# Must be at least 32 characters (256 bits)
# REQUIRED - Application will fail if not set
JWT_SECRET=<GENERATE-STRONG-SECRET-HERE>

# ============================================================
# CORS & SECURITY
# ============================================================
# Set to your exact Vercel frontend domain for security
# NEVER use wildcards (*) in production for specific domains
# Format: https://yourdomain.vercel.app or comma-separated list
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# ============================================================
# APPLICATION & SERVER
# ============================================================
# Activates production profile with optimized settings
SPRING_PROFILES_ACTIVE=prod

# Port (Railway usually sets this automatically)
# Uncomment if Railway doesn't set PORT
# PORT=8080

# ============================================================
# OPTIONAL SECURITY ENHANCEMENT
# ============================================================
# Uncomment to hide stack traces from error responses
# SERVER_ERROR_INCLUDE_STACKTRACE=never

# ============================================================
# OPTIONAL MONITORING
# ============================================================
# Uncomment to enable additional actuator endpoints
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics

# ============================================================
# HOW TO USE THIS FILE
# ============================================================
# 1. Go to https://railway.app/project/your-project-id
# 2. Select your backend service
# 3. Go to "Environment" tab
# 4. Add each variable with its production value
# 5. Replace placeholders with actual values
# 6. Click "Redeploy" to apply changes
#
# IMPORTANT: Never commit real secrets to git
# Always use the Railway dashboard for production secrets
