# Backend Environment Variables

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/finance
DATABASE_USERNAME=dev
DATABASE_PASSWORD=dev

# JWT Configuration
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=ledgerly-dev-secret-key-must-be-at-least-256-bits-long-for-hs256

# CORS Configuration
# Comma-separated list of allowed origins (supports wildcards with *)
# For development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# For production with specific Vercel domain
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# For production allowing all Vercel deployments (less secure but convenient)
# CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:3000

# Server Configuration
PORT=8080

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
